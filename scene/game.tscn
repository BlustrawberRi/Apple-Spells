[node name="Note On the Wall" parent="SceneItemLoader" instance=ExtResource("7_5x76a")]
position = Vector2(322, -44)
ItemDescription = "I have a song stuck in my head.... I asked my friends if they knew it, but they didn't. It drives me crazy. If anyone knows this song, please tell me what it is.


[wave amp=20.0 freq=1.0]When the sun goes down and the moonlight pours in my room
Then the (line?) goes wild and there's nothing else I can do
I just sit here and wait
while I still contemplate
all the things I have learned 
how my brain becomes numb[/wave]"

